# Ruta base de la API. En desarrollo y en Docker se usa el proxy same-origin.
VITE_API_BASE=/api

# true: la capa de servicios responde con fixtures locales.
# false: habla con FastAPI.
VITE_USE_MOCKS=true

# Latencia simulada de los mocks, en milisegundos.
VITE_MOCK_LATENCY=450

# Destino del proxy de Vite (solo desarrollo).
VITE_PROXY_TARGET=http://127.0.0.1:8000
