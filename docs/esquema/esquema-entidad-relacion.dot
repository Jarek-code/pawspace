  er_PUBLICACION -> er_COMENTARIO [style=invis, weight=10];

  er_COMENTARIO [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#e8e0f5" COLSPAN="3"><B>COMENTARIO</B></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">BIGINT UNSIGNED</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK, AI</FONT></TD></TR><TR><TD ALIGN="LEFT">publicacion_id<FONT POINT-SIZE="8" COLOR="#1a4f8a"> &#8594; PUBLICACION</FONT></TD><TD ALIGN="LEFT">BIGINT UNSIGNED</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">mascota_id<FONT POINT-SIZE="8" COLOR="#1a4f8a"> &#8594; MASCOTA</FONT></TD><TD ALIGN="LEFT">BIGINT UNSIGNED</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">comentario_padre_id<FONT POINT-SIZE="8" COLOR="#1a4f8a"> &#8594; COMENTARIO</FONT></TD><TD ALIGN="LEFT">BIGINT UNSIGNED NULL</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">texto</TD><TD ALIGN="LEFT">TEXT</TD><TD> </TD></TR><TR><TD ALIGN="LEFT">fijado_en</TD><TD ALIGN="LEFT">DATETIME NULL</TD><TD> </TD></TR><TR><TD ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT">DATETIME</TD><TD> </TD></TR><TR><TD ALIGN="LEFT">actualizado_en</TD><TD ALIGN="LEFT">DATETIME</TD><TD> </TD></TR><TR><TD ALIGN="LEFT">eliminado_en</TD><TD ALIGN="LEFT">DATETIME NULL</TD><TD> </TD></TR></TABLE>>]
  er_COMENTARIO_IMAGEN [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#e8e0f5" COLSPAN="3"><B>COMENTARIO_IMAGEN</B></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">BIGINT UNSIGNED</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK, AI</FONT></TD></TR><TR><TD ALIGN="LEFT">comentario_id<FONT POINT-SIZE="8" COLOR="#1a4f8a"> &#8594; COMENTARIO</FONT></TD><TD ALIGN="LEFT">BIGINT UNSIGNED</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">posicion</TD><TD ALIGN="LEFT">SMALLINT UNSIGNED</TD><TD> </TD></TR><TR><TD ALIGN="LEFT">archivo_url</TD><TD ALIGN="LEFT">VARCHAR(2048)</TD><TD> </TD></TR></TABLE>>]

  { rank=same; er_COMENTARIO; er_COMENTARIO_IMAGEN }
  er_COMENTARIO -> er_COMENTARIO_IMAGEN [style=invis, weight=100];
