// Esquema entidad-relacion de PawSpace (modelo logico): 29 tablas y sus claves
// foraneas, sin nodos ni replicacion.

digraph pawspace_er {
  graph [rankdir="TB", fontname="Helvetica", fontsize="11",
         labelloc="t", labeljust="c", compound="true", newrank="true",
         nodesep="0.3", ranksep="0.35", splines="ortho",
         label=<<FONT POINT-SIZE="20"><B>PawSpace - modelo entidad-relacion</B></FONT>>]
  node [shape="plaintext", fontname="Helvetica", fontsize="9"]
  edge [fontname="Helvetica", fontsize="8", color="#8fb8dc", arrowsize="0.7"]

  er_USUARIO [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#dbe9f6" COLSPAN="3"><B>USUARIO</B></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">BIGINT UNSIGNED</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK, AI</FONT></TD></TR><TR><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT">VARCHAR(255)</TD><TD> </TD></TR><TR><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">VARCHAR(320)</TD><TD> </TD></TR><TR><TD ALIGN="LEFT">contrasena_hash</TD><TD ALIGN="LEFT">VARCHAR(255)</TD><TD> </TD></TR><TR><TD ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT">DATETIME</TD><TD> </TD></TR><TR><TD ALIGN="LEFT">actualizado_en</TD><TD ALIGN="LEFT">DATETIME</TD><TD> </TD></TR><TR><TD ALIGN="LEFT">activo</TD><TD ALIGN="LEFT">BOOLEAN</TD><TD> </TD></TR></TABLE>>]

  er_USUARIO -> er_MASCOTA [style=invis, weight=10];

  er_MASCOTA [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#d6f0d6" COLSPAN="3"><B>MASCOTA</B></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">BIGINT UNSIGNED</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK, AI</FONT></TD></TR><TR><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT">VARCHAR(100)</TD><TD> </TD></TR><TR><TD ALIGN="LEFT">nombre_usuario</TD><TD ALIGN="LEFT">VARCHAR(50)</TD><TD> </TD></TR><TR><TD ALIGN="LEFT">especie_id<FONT POINT-SIZE="8" COLOR="#1a4f8a"> &#8594; ESPECIE</FONT></TD><TD ALIGN="LEFT">SMALLINT UNSIGNED</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">raza_id<FONT POINT-SIZE="8" COLOR="#1a4f8a"> &#8594; RAZA</FONT></TD><TD ALIGN="LEFT">INT UNSIGNED NULL</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">sexo</TD><TD ALIGN="LEFT">CHAR(1) NULL</TD><TD> </TD></TR><TR><TD ALIGN="LEFT">fecha_nacimiento</TD><TD ALIGN="LEFT">DATE NULL</TD><TD> </TD></TR><TR><TD ALIGN="LEFT">biografia</TD><TD ALIGN="LEFT">VARCHAR(1000) NULL</TD><TD> </TD></TR><TR><TD ALIGN="LEFT">foto_perfil_url</TD><TD ALIGN="LEFT">VARCHAR(2048) NULL</TD><TD> </TD></TR><TR><TD ALIGN="LEFT">es_privada</TD><TD ALIGN="LEFT">BOOLEAN</TD><TD> </TD></TR><TR><TD ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT">DATETIME</TD><TD> </TD></TR><TR><TD ALIGN="LEFT">actualizado_en</TD><TD ALIGN="LEFT">DATETIME</TD><TD> </TD></TR></TABLE>>]
  er_ESPECIE [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#d6f0d6" COLSPAN="3"><B>ESPECIE</B></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">SMALLINT UNSIGNED</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK, AI</FONT></TD></TR><TR><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT">VARCHAR(100)</TD><TD> </TD></TR></TABLE>>]
  er_RAZA [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#d6f0d6" COLSPAN="3"><B>RAZA</B></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">INT UNSIGNED</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK, AI</FONT></TD></TR><TR><TD ALIGN="LEFT">especie_id<FONT POINT-SIZE="8" COLOR="#1a4f8a"> &#8594; ESPECIE</FONT></TD><TD ALIGN="LEFT">SMALLINT UNSIGNED</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT">VARCHAR(100)</TD><TD> </TD></TR></TABLE>>]
  er_USUARIO_MASCOTA [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#d6f0d6" COLSPAN="3"><B>USUARIO_MASCOTA</B></TD></TR><TR><TD ALIGN="LEFT">usuario_id<FONT POINT-SIZE="8" COLOR="#1a4f8a"> &#8594; USUARIO</FONT></TD><TD ALIGN="LEFT">BIGINT UNSIGNED</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK, FK</FONT></TD></TR><TR><TD ALIGN="LEFT">mascota_id<FONT POINT-SIZE="8" COLOR="#1a4f8a"> &#8594; MASCOTA</FONT></TD><TD ALIGN="LEFT">BIGINT UNSIGNED</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK, FK</FONT></TD></TR><TR><TD ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT">DATETIME</TD><TD> </TD></TR></TABLE>>]

  { rank=same; er_MASCOTA; er_ESPECIE; er_RAZA; er_USUARIO_MASCOTA }
  er_MASCOTA -> er_ESPECIE [style=invis, weight=100];
  er_ESPECIE -> er_RAZA [style=invis, weight=100];
  er_RAZA -> er_USUARIO_MASCOTA [style=invis, weight=100];
  er_MASCOTA -> er_SEGUIMIENTO [style=invis, weight=10];

  er_SEGUIMIENTO [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#fbe3e0" COLSPAN="3"><B>SEGUIMIENTO</B></TD></TR><TR><TD ALIGN="LEFT">seguidor_id<FONT POINT-SIZE="8" COLOR="#1a4f8a"> &#8594; MASCOTA</FONT></TD><TD ALIGN="LEFT">BIGINT UNSIGNED</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK, FK</FONT></TD></TR><TR><TD ALIGN="LEFT">seguido_id<FONT POINT-SIZE="8" COLOR="#1a4f8a"> &#8594; MASCOTA</FONT></TD><TD ALIGN="LEFT">BIGINT UNSIGNED</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK, FK</FONT></TD></TR><TR><TD ALIGN="LEFT">estado</TD><TD ALIGN="LEFT">ENUM( 'PENDIENTE', 'ACEPTADO', 'RECHAZADO' )</TD><TD> </TD></TR><TR><TD ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT">DATETIME</TD><TD> </TD></TR><TR><TD ALIGN="LEFT">actualizado_en</TD><TD ALIGN="LEFT">DATETIME</TD><TD> </TD></TR></TABLE>>]
  er_BLOQUEO [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#fbe3e0" COLSPAN="3"><B>BLOQUEO</B></TD></TR><TR><TD ALIGN="LEFT">bloqueador_id<FONT POINT-SIZE="8" COLOR="#1a4f8a"> &#8594; MASCOTA</FONT></TD><TD ALIGN="LEFT">BIGINT UNSIGNED</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK, FK</FONT></TD></TR><TR><TD ALIGN="LEFT">bloqueado_id<FONT POINT-SIZE="8" COLOR="#1a4f8a"> &#8594; MASCOTA</FONT></TD><TD ALIGN="LEFT">BIGINT UNSIGNED</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK, FK</FONT></TD></TR><TR><TD ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT">DATETIME</TD><TD> </TD></TR></TABLE>>]

  { rank=same; er_SEGUIMIENTO; er_BLOQUEO }
  er_SEGUIMIENTO -> er_BLOQUEO [style=invis, weight=100];
  er_SEGUIMIENTO -> er_PUBLICACION [style=invis, weight=10];

  er_PUBLICACION [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#fbd9b5" COLSPAN="3"><B>PUBLICACION</B></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">BIGINT UNSIGNED</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK, AI</FONT></TD></TR><TR><TD ALIGN="LEFT">mascota_id<FONT POINT-SIZE="8" COLOR="#1a4f8a"> &#8594; MASCOTA</FONT></TD><TD ALIGN="LEFT">BIGINT UNSIGNED</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">publicacion_origen_id<FONT POINT-SIZE="8" COLOR="#1a4f8a"> &#8594; PUBLICACION</FONT></TD><TD ALIGN="LEFT">BIGINT UNSIGNED NULL</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">texto</TD><TD ALIGN="LEFT">TEXT NULL</TD><TD> </TD></TR><TR><TD ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT">DATETIME</TD><TD> </TD></TR><TR><TD ALIGN="LEFT">actualizado_en</TD><TD ALIGN="LEFT">DATETIME</TD><TD> </TD></TR><TR><TD ALIGN="LEFT">eliminado_en</TD><TD ALIGN="LEFT">DATETIME NULL</TD><TD> </TD></TR></TABLE>>]
  er_PUBLICACION_ADJUNTO [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#fbd9b5" COLSPAN="3"><B>PUBLICACION_ADJUNTO</B></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">BIGINT UNSIGNED</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK, AI</FONT></TD></TR><TR><TD ALIGN="LEFT">publicacion_id<FONT POINT-SIZE="8" COLOR="#1a4f8a"> &#8594; PUBLICACION</FONT></TD><TD ALIGN="LEFT">BIGINT UNSIGNED</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">tipo</TD><TD ALIGN="LEFT">ENUM( 'IMAGEN', 'VIDEO' )</TD><TD> </TD></TR><TR><TD ALIGN="LEFT">posicion</TD><TD ALIGN="LEFT">SMALLINT UNSIGNED</TD><TD> </TD></TR><TR><TD ALIGN="LEFT">archivo_url</TD><TD ALIGN="LEFT">VARCHAR(2048)</TD><TD> </TD></TR><TR><TD ALIGN="LEFT">duracion_seg</TD><TD ALIGN="LEFT">INT UNSIGNED NULL</TD><TD> </TD></TR></TABLE>>]
  er_PUBLICACION_GUARDADA [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#fbd9b5" COLSPAN="3"><B>PUBLICACION_GUARDADA</B></TD></TR><TR><TD ALIGN="LEFT">usuario_id<FONT POINT-SIZE="8" COLOR="#1a4f8a"> &#8594; USUARIO</FONT></TD><TD ALIGN="LEFT">BIGINT UNSIGNED</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK, FK</FONT></TD></TR><TR><TD ALIGN="LEFT">publicacion_id<FONT POINT-SIZE="8" COLOR="#1a4f8a"> &#8594; PUBLICACION</FONT></TD><TD ALIGN="LEFT">BIGINT UNSIGNED</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK, FK</FONT></TD></TR><TR><TD ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT">DATETIME</TD><TD> </TD></TR></TABLE>>]

