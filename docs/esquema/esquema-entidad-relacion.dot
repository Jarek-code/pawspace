  er_ME_GUSTA_PUBLICACION [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="2"><TR><TD BGCOLOR="#d9f2f2" COLSPAN="3"><B>ME_GUSTA_PUBLICACION</B></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">BIGINT UNSIGNED</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK, AI</FONT></TD></TR><TR><TD ALIGN="LEFT">publicacion_id<FONT POINT-SIZE="8" COLOR="#1a4f8a"> &#8594; PUBLICACION</FONT></TD><TD ALIGN="LEFT">BIGINT UNSIGNED</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">mascota_id<FONT POINT-SIZE="8" COLOR="#1a4f8a"> &#8594; MASCOTA</FONT></TD><TD ALIGN="LEFT">BIGINT UNSIGNED</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">creado_en</TD><TD ALIGN="LEFT">DATETIME</TD><TD> </TD></TR></TABLE>>]
