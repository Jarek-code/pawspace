{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "PawSpace Design Tokens",
    "version": "1.1.0",
    "description": "Tokens base del design system de PawSpace. Tema claro y oscuro, tipografia Outfit e Inter, paleta coral, crema y verde bosque."
  },
  "color": {
    "coral": {
      "50": "#FFF1EF",
      "100": "#FFE2DE",
      "200": "#FFC7C0",
      "300": "#FFA79D",
      "400": "#F9867A",
      "500": "#F26B5E",
      "600": "#D9564A",
      "700": "#C94C41",
      "800": "#A63A32",
      "900": "#7E2B25"
    },
    "forest": {
      "50": "#EEF5F0",
      "100": "#D8E9DE",
      "200": "#B4D3C0",
      "300": "#86B59D",
      "400": "#5D9479",
      "500": "#41785F",
      "600": "#2F5D4A",
      "700": "#244A3B",
      "800": "#1B3A2E",
      "900": "#132A21"
    },
    "cream": {
      "50": "#FFF8F0",
      "100": "#FBEFE2",
      "200": "#F4E2CF",
      "300": "#E8D0B8",
      "400": "#D2B69A",
      "500": "#B3967A",
      "600": "#8C725A",
      "700": "#6B5745",
      "800": "#4A3D32",
      "900": "#2E2721"
    },
    "ink": {
      "50": "#F7FAF8",
      "100": "#F0F4F1",
      "200": "#E3E9E5",
      "300": "#C9D2CC",
      "400": "#A3AFA8",
      "500": "#7A8880",
      "600": "#5C6B62",
      "700": "#3E4C44",
      "800": "#2B3831",
      "900": "#1F2A24"
    },
    "sun": {
      "50": "#FFF8E6",
      "100": "#FFEDBF",
      "200": "#FFDD85",
      "300": "#F9C95C",
      "400": "#F2B24C",
      "500": "#D99A32",
      "600": "#B57B1F",
      "700": "#8F5E14"
    },
    "success": {
      "50": "#E8F5EE",
      "100": "#C9E9D8",
      "500": "#3C9470",
      "600": "#2E7D5B",
      "700": "#1F5C42"
    },
    "warning": {
      "50": "#FDF5E6",
      "100": "#F8E6BF",
      "500": "#D18F27",
      "600": "#B7791F",
      "700": "#8A5A14"
    },
    "danger": {
      "50": "#FDECEA",
      "100": "#F8D2CE",
      "500": "#D33A2E",
      "600": "#B42318",
      "700": "#8F1B12"
    }
  },
  "semantic": {
    "light": {
      "bg": "{color.cream.50}",
      "bgSubtle": "{color.cream.100}",
      "surface": "#FFFFFF",
      "surfaceRaised": "#FFFFFF",
      "surfaceSunken": "{color.cream.200}",
      "border": "{color.cream.300}",
      "borderStrong": "{color.cream.400}",
      "text": "{color.ink.900}",
      "textMuted": "{color.ink.600}",
      "textSubtle": "{color.ink.500}",
      "textInverse": "{color.cream.50}",
      "primary": "{color.coral.700}",
      "primaryHover": "{color.coral.800}",
      "primaryActive": "{color.coral.900}",
      "primarySoft": "{color.coral.50}",
      "onPrimary": "#FFFFFF",
      "secondary": "{color.forest.600}",
      "secondaryHover": "{color.forest.700}",
      "secondarySoft": "{color.forest.50}",
      "onSecondary": "#FFFFFF",
      "accent": "{color.sun.400}",
      "onAccent": "{color.ink.900}",
      "success": "{color.success.600}",
      "successSoft": "{color.success.50}",
      "warning": "{color.warning.600}",
      "warningSoft": "{color.warning.50}",
      "danger": "{color.danger.600}",
      "dangerSoft": "{color.danger.50}",
      "focus": "{color.forest.600}",
      "overlay": "rgba(31, 42, 36, 0.48)"
    },
    "dark": {
      "bg": "#141A17",
      "bgSubtle": "#1B231F",
      "surface": "#1D2521",
      "surfaceRaised": "#24302A",
      "surfaceSunken": "#111613",
      "border": "#35423B",
      "borderStrong": "#4A5A52",
      "text": "#F5EFE6",
      "textMuted": "#B8C4BD",
      "textSubtle": "#8A9A92",
      "textInverse": "{color.ink.900}",
      "primary": "{color.coral.300}",
      "primaryHover": "{color.coral.200}",
      "primaryActive": "{color.coral.100}",
      "primarySoft": "#35211F",
      "onPrimary": "{color.ink.900}",
      "secondary": "{color.forest.300}",
      "secondaryHover": "{color.forest.200}",
      "secondarySoft": "#1B2E26",
      "onSecondary": "{color.forest.900}",
      "accent": "{color.sun.400}",
      "onAccent": "{color.ink.900}",
      "success": "{color.forest.400}",
      "successSoft": "#163025",
      "warning": "{color.sun.400}",
      "warningSoft": "#332610",
      "danger": "{color.coral.400}",
      "dangerSoft": "#351A18",
      "focus": "{color.sun.400}",
      "overlay": "rgba(0, 0, 0, 0.60)"
    }
  },
  "typography": {
    "family": {
      "display": "'Outfit', system-ui, -apple-system, sans-serif",
      "body": "'Inter', system-ui, -apple-system, sans-serif"
    },
    "weight": {
      "regular": 400,
      "semibold": 600,
      "bold": 700,
      "extrabold": 800
    },
    "textStyle": {
      "displayXl": { "fontFamily": "{typography.family.display}", "fontSize": "48px", "lineHeight": "56px", "fontWeight": 800 },
      "displayLg": { "fontFamily": "{typography.family.display}", "fontSize": "40px", "lineHeight": "48px", "fontWeight": 800 },
      "h1": { "fontFamily": "{typography.family.display}", "fontSize": "32px", "lineHeight": "40px", "fontWeight": 800 },
      "h2": { "fontFamily": "{typography.family.display}", "fontSize": "28px", "lineHeight": "36px", "fontWeight": 700 },
      "h3": { "fontFamily": "{typography.family.display}", "fontSize": "24px", "lineHeight": "32px", "fontWeight": 700 },
      "h4": { "fontFamily": "{typography.family.display}", "fontSize": "20px", "lineHeight": "28px", "fontWeight": 700 },
      "bodyLg": { "fontFamily": "{typography.family.body}", "fontSize": "18px", "lineHeight": "28px", "fontWeight": 400 },
      "body": { "fontFamily": "{typography.family.body}", "fontSize": "16px", "lineHeight": "24px", "fontWeight": 400 },
      "bodySm": { "fontFamily": "{typography.family.body}", "fontSize": "14px", "lineHeight": "20px", "fontWeight": 400 },
      "label": { "fontFamily": "{typography.family.body}", "fontSize": "14px", "lineHeight": "20px", "fontWeight": 600 },
      "caption": { "fontFamily": "{typography.family.body}", "fontSize": "12px", "lineHeight": "16px", "fontWeight": 600 },
      "overline": { "fontFamily": "{typography.family.body}", "fontSize": "12px", "lineHeight": "16px", "fontWeight": 700, "letterSpacing": "0.08em", "textCase": "uppercase" }
    }
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "20": "80px",
    "24": "96px"
  },
  "radius": {
    "xs": "6px",
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px",
    "full": "999px"
  },
  "border": {
    "width": "1px",
    "widthStrong": "2px"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(31, 42, 36, 0.08)",
    "md": "0 4px 12px rgba(31, 42, 36, 0.10)",
    "lg": "0 12px 32px rgba(31, 42, 36, 0.14)"
  },
  "motion": {
    "durationFast": "120ms",
    "durationBase": "200ms",
    "durationSlow": "320ms",
    "easeStandard": "cubic-bezier(0.2, 0, 0, 1)",
    "easeOut": "cubic-bezier(0.4, 0, 1, 1)"
  },
  "zIndex": {
    "base": 0,
    "sticky": 100,
    "dropdown": 1000,
    "overlay": 1200,
    "modal": 1300,
    "toast": 1400
  },
  "breakpoint": {
    "xs": "390px",
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "2xl": "1440px"
  },
  "layout": {
    "contentMax": "1200px",
    "formMax": "440px",
    "gutterDesktop": "24px",
    "gutterTablet": "20px",
    "gutterMobile": "16px",
    "marginDesktop": "32px",
    "marginTablet": "24px",
    "marginMobile": "16px",
    "controlHeightLg": "48px",
    "controlHeightMd": "44px",
    "controlHeightSm": "36px",
    "touchTarget": "44px"
  }
}
