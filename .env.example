# Plantilla de variables de entorno para PawSpace.
# Copiala antes de levantar el cluster:
#     cp .env.example .env

# Base de datos distribuida
DB_ROOT_PASSWORD=rootpass

# Nombre de la base. El esquema logico esta en database/schema.sql.
DB_NAME=pawspace

# Usuario de la aplicacion. Se crea en el nodo spider, que es por donde entra
# todo: database/distribuida/nodo-spider/04-usuario-aplicacion.sql
DB_USER=pawuser
DB_PASSWORD=pawpass

# Como se conecta el backend
DB_HOST=127.0.0.1
DB_PORT=14306

# Opciones de arranque
ADMINER_PORT=8081
